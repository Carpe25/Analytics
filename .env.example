# ==========================================
# Project Time Analytics Environment Config
# ==========================================

# Application
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata

# Google Sheets Integration (Server-Side Only)
# GOOGLE_AUTH_MODE: "service_account" or "api_key"
GOOGLE_AUTH_MODE=service_account
# If service_account:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Private key with newlines represented as \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Optional inline JSON configuration or reference to config file
# GOOGLE_SHEETS_SOURCE_CONFIG=

# GitHub Integration (Server-Side Only)
# GITHUB_AUTH_MODE: "token" or "github_app"
GITHUB_AUTH_MODE=token
# Fine-grained personal access token or classic token (read:repo scope)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
# If using GitHub App:
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# Durable Non-Database Artifact Storage
# Options: "local" (for local dev only) | "s3" (AWS S3, Cloudflare R2, MinIO) | "gdrive"
ARTIFACT_STORAGE_PROVIDER=local
ARTIFACT_STORAGE_LOCAL_DIR=.artifacts

# If using S3 / S3-compatible (Cloudflare R2, MinIO, etc.)
ARTIFACT_STORAGE_BUCKET=
ARTIFACT_STORAGE_REGION=us-east-1
ARTIFACT_STORAGE_ENDPOINT=
ARTIFACT_STORAGE_ACCESS_KEY=
ARTIFACT_STORAGE_SECRET_KEY=

# Scheduled Cron and Sync Protection
# Secret required in Authorization header: Bearer <CRON_SECRET>
CRON_SECRET=change-this-to-a-secure-random-token-in-production
# Secret or password for manual sync from the UI (optional for local MVP, recommended for production)
MANUAL_SYNC_SECRET=

# Feature Settings
ENABLE_DAILY_SNAPSHOTS=false
GITHUB_INITIAL_IMPORT_DAYS=90
GITHUB_MAX_COMMITS_PER_REPOSITORY=500
